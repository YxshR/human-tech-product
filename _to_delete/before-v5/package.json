{
  "name": "humantech-hrms",
  "private": true,
  "version": "0.1.0",
  "description": "humanTech HRMS & Payroll SaaS - India-first, multi-tenant",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres mailpit minio",
    "db:migrate": "pnpm --filter @humantech/database migrate",
    "db:seed": "pnpm --filter @humantech/database seed",
    "db:test": "pnpm --filter @humantech/database test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
