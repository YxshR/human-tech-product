# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
LOG_LEVEL=debug

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Owner/migration role (DDL). Used ONLY by `pnpm db:migrate` and CI.
DATABASE_OWNER_URL=postgresql://humantech_owner:owner_dev_password@localhost:5432/humantech
# Runtime role (least privilege: not owner, NOBYPASSRLS). Used by API + worker.
DATABASE_URL=postgresql://humantech_app:app_dev_password@localhost:5432/humantech

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=humantech-dev
OBJECT_STORAGE_REGION=local
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

EMAIL_FROM=dev@humantech.local
EMAIL_HOST=localhost
EMAIL_PORT=1025

# OIDC (see ADR-0003). Dev issuer is refused when NODE_ENV=production.
OIDC_ISSUER=http://localhost:4000/dev-idp
OIDC_AUDIENCE=humantech-api

# ---- API (apps/api) ----
PORT=4000
OIDC_ISSUER=https://your-idp.example.com
OIDC_AUDIENCE=humantech-api
# OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
# ---- Worker (apps/worker) ----
# DATABASE_URL = humantech_app role; DATABASE_SYSTEM_URL = humantech_system role (must differ)
DATABASE_SYSTEM_URL=postgresql://humantech_system:change-me@localhost:5432/humantech
WORKER_CONCURRENCY=4

# ---- Web (apps/web) ----
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
OIDC_CLIENT_ID=humantech-web
# OIDC_CLIENT_SECRET=
# OIDC_USE_ID_TOKEN=false   # true if your IdP issues no API access token
