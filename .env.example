# Copy to .env for local development. NEVER commit real secrets.
# Each app reads only the variables listed under its own heading; shared ones are repeated where needed.
NODE_ENV=development

# ---- Database roles (see ADR-0004) -------------------------------------------------------------------
# Owner role (DDL): used ONLY by `pnpm db:migrate` / `db:seed` and CI.
DATABASE_OWNER_URL=postgresql://humantech_owner:owner_dev_password@localhost:5432/humantech
# Runtime role (not owner, NOBYPASSRLS): API + worker.
DATABASE_URL=postgresql://humantech_app:app_dev_password@localhost:5432/humantech
# System role (queue claim/complete, scheduler, platform CLI). Must differ from DATABASE_URL.
DATABASE_SYSTEM_URL=postgresql://humantech_system:system_dev_password@localhost:5432/humantech
# One-time role bootstrap (superuser): `pnpm --filter @humantech/database bootstrap`
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# DATABASE_NAME=humantech
# DB_OWNER_PASSWORD=owner_dev_password
# DB_APP_PASSWORD=app_dev_password
# DB_SYSTEM_PASSWORD=system_dev_password
# Platform CLI (activate-payroll, import-rules, approve-rule): who is acting. Or pass --operator.
# OPERATOR_EMAIL=you@humantech.example

# ---- API (apps/api) -----------------------------------------------------------------------------------
PORT=4000
DATABASE_POOL_MAX=10
OIDC_ISSUER=https://your-idp.example.com
OIDC_AUDIENCE=humantech-api
# OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json   # default: <issuer>/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
BODY_LIMIT=100kb
# Field encryption: "id:base64(32 bytes)[,id:...]" — first key encrypts, all decrypt (rotation). Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTES_xxxxxxxxxxxxxxxxxxxx=
# Duplicate detection of identifiers. Separate key. Generate: openssl rand -base64 32
BLIND_INDEX_KEY=REPLACE_WITH_BASE64_32_BYTES_xxxxxxxxxxxxxxxxxxxx=
# Signs 60-second download links. >= 32 characters. Generate: openssl rand -hex 32
FILE_SIGNING_SECRET=replace-with-at-least-32-random-characters
MAX_UPLOAD_BYTES=10485760

# ---- File storage (API + worker; same values in both) ---------------------------------------------------
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./.data/files
# S3_BUCKET=humantech-dev
# S3_ENDPOINT=http://localhost:9000      # MinIO / other S3-compatible
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# ---- Worker (apps/worker) -------------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
# WORKER_ID=worker-1
SCHEDULER_INTERVAL_MS=3600000
# smtp://user:pass@host:587 — unset in development: e-mails are logged, not sent. Required in production.
# SMTP_URL=smtp://localhost:1025
MAIL_FROM=humanTech <no-reply@humantech.local>
WEB_BASE_URL=http://localhost:3000

# ---- Web (apps/web) -------------------------------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
OIDC_CLIENT_ID=humantech-web
# OIDC_CLIENT_SECRET=
# Scopes requested at sign-in. Add offline_access if your IdP needs it to issue a refresh token.
# OIDC_SCOPE=openid profile email offline_access
# OIDC_USE_ID_TOKEN=false        # true if your IdP issues no API access token

# ---- Tests ----------------------------------------------------------------------------------------------
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# TEST_LOG=1                     # show server errors while running API tests
